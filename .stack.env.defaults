# .stack.env.defaults — tracked, stack-core defaults used by `just setup`.
#
# Setup behaviour:
#   - First run (no .stack/.env): copies this file to .stack/.env verbatim.
#   - Every run: additively merges any KEY from this file that's missing
#     from .stack/.env (never overwrites existing values). Safe to re-run.
#
# This file is intentionally LEAN: it only declares stack-core stuff that
# doesn't belong to any one service (project name, provider API keys,
# stack-wide LLM model defaults, the initial COMPOSE_PROFILES picks).
# Per-service config lives in services/<svc>/service.env's
# SERVICE_STACK_ENV and gets injected into .stack/.env as a
# #>--- svc --- block by `just enable <svc>`.

# Per-stack identity. Project name scopes containers/volumes/network;
# OrbStack exposes services at <service>.<project>.orb.local. Use a
# DISTINCT name per stack to run several side by side.
COMPOSE_PROJECT_NAME=aitools

# Provider API keys (consumed by LiteLLM at container runtime)
# Setup prompts for both interactively
OPENROUTER_API_KEY=
VOYAGE_API_KEY=

# Stack-wide LLM model levers — referenced by per-service *_MODEL levers
# inside their blocks via ${STACK_LLM_MODEL[_FAST|_EMBEDDING_MODEL]}.
# These live above all blocks because bash sources .stack/.env top-to-
# bottom and these MUST be defined before any block that interpolates them.
STACK_LLM_MODEL=cliproxy/gpt-5.5            # primary chat (interactive / high-tier)
STACK_LLM_MODEL_FAST=cliproxy/gpt-5.4-mini  # high-volume background tier
STACK_LLM_EMBEDDING_MODEL=voyage-4-lite     # embeddings (via litellm -> voyage)

# Default opt-in selection — `just setup` auto-enables each, which
# cascades transitive SERVICE_REQUIRES (so pg/redis come in for free
# from litellm; honcho's deps from honcho; etc.) AND writes each
# service's #>--- svc --- block to .stack/.env. Override before
# running setup, or change later via `just enable`/`just disable`.
COMPOSE_PROFILES=litellm,cliproxyapi,honcho,honcho-ui
STACK_MACHINES=hermes

# Behavioral flags
# Remove provisional containers after they run - keep as false to see logs.
# Provisional containers initialize db credentials during `just start`
STACK_AUTO_REMOVE_PROVISIONERS=false
