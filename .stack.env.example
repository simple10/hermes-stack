# Copy to .stack/.env (gitignored) — or run `just setup` to generate it.
# This is the ONLY hand-edited secrets file. db passwords + minted virtual
# keys are machine-owned in .stack/*.generated.env (never hand-edit those).

# --- providers (consumed by LiteLLM at container runtime) ---
OPENROUTER_API_KEY=
VOYAGE_API_KEY=

# --- LiteLLM admin key (blank => `just setup` generates a stable one) ---
LITELLM_MASTER_KEY=

# --- agentmemory bearer/HMAC secret (blank => `just setup` generates one;
# authoritative over the value in the agentmemory volume) ---
AGENTMEMORY_SECRET=

# --- agentmemory admin web UI (viewer, :3113) ---
# 1 = expose at agentmemory.<project>.orb.local:3113 (default).
# Set 0 to DISABLE: it's an UNAUTHENTICATED admin surface; when 0 the viewer
# stays 127.0.0.1-only inside the container (unreachable via orb DNS).
AGENTMEMORY_EXPOSE_VIEWER=1

# --- cliproxyapi (OAuth-subscription proxy: ChatGPT Codex/Gemini/Claude/Grok)
# blank => `just setup` generates. CLIPROXY_API_KEY = client key to call the
# proxy; CLIPROXY_MANAGEMENT_KEY gates the management/OAuth-login panel.
# Both are injected into the gitignored config.runtime.yaml by build.sh. ---
CLIPROXY_API_KEY=
CLIPROXY_MANAGEMENT_KEY=
# Pinned image tag (gotcha #6) — bump deliberately.
CLIPROXY_VERSION=v7.1.11

# --- Telegram (Hermes gateway; only needed if machines includes hermes) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# --- per-stack identity ---
# Compose project name. Containers/volumes/network are scoped to it, so
# multiple independent stacks can run side by side — give each a DISTINCT
# name. OrbStack exposes services at <service>.<project>.orb.local
# (e.g. litellm.aitools.orb.local, honcho-api.aitools.orb.local).
COMPOSE_PROJECT_NAME=aitools

# --- what runs ---
# Docker service profiles (single source of truth; deps auto-pulled).
# Available: litellm, honcho, honcho-ui, agentmemory, hindsight, cliproxyapi,
#            firecrawl, browser-use.
# agentmemory is standalone (no pg/redis/litellm dependency; file-based state
# on its own volume).
# honcho-ui: OPTIONAL static web UI for Honcho (OpenConcho). Opt-in — add
# `honcho-ui`; it auto-pulls honcho-api. Open https://honcho-ui.<project>
# .orb.local (OrbStack auto-HTTPS) — the connect form is pre-filled with the
# same-origin Honcho proxy (token, if any, is still entered there
# manually), so just click Save.
# hindsight: OPTIONAL pg-backed agent memory (LiteLLM-routed). Opt-in — add
# `hindsight` here. New pg role/db => recreate the <project>_pg-data volume.
# cliproxyapi: OPTIONAL standalone OAuth-subscription proxy (NOT a LiteLLM
# consumer). Opt-in — add `cliproxyapi` here; then OAuth-login providers via
# its management panel (one-time, manual).
# firecrawl: OPTIONAL web-scraper API (nuq). Opt-in — add `firecrawl`. Heavy
# (api+playwright+dedicated pg+rabbitmq, all profile-scoped to firecrawl);
# auto-pulls litellm. Extract routed via LiteLLM (FIRECRAWL_VIRTUAL_KEY).
# camofox-browser: OPTIONAL stealth headless-browser API (Camoufox/Firefox)
# for agents. Opt-in — add `camofox-browser`. STANDALONE (no backends);
# built from pinned _source. CAMOFOX_ACCESS_KEY is GENERATED into
# .stack/camofox-browser/.generated.env (NOT hand-edited here).
# When the camofox-browser profile is active, machines/hermes/build.sh seeds
# CAMOFOX_URL=http://camofox-browser.<project>.orb.local:9377 into the VM's
# ~/.hermes/.env so Hermes auto-uses Camofox as its browser_provider.
# Auth lever (required for the Hermes path — Hermes doesn't send bearer auth):
#   CAMOFOX_AUTH=disabled   # drops the bearer-key gate; server is unauthenticated
#                           # (orb-DNS-only exposure is the trust boundary).
#                           # Default = generate + require a bearer key.
# Other optional levers (all have defaults; add only to override):
#   CAMOFOX_MEM=2g  CAMOFOX_CPU=2  CAMOFOX_HEAP_MB=128
#
# === chrome-cdp + localhost-proxy (host bridge for isolated VMs) ===================
# `just chrome-cdp` launches a dedicated Chrome on the Mac with CDP enabled
# and brings up `localhost-proxy` (alpine + socat, profile [localhost-proxy])
# inside this stack's docker network. The hermes VM is --isolated +
# --isolate-network, so it CANNOT reach Mac IPs directly — it reaches Chrome
# ONLY through the proxy container (containers are not subject to VM
# isolation, so they can talk to the Mac via host.docker.internal). Blast
# radius of a compromised Hermes dep = the ports in LOCALHOST_PROXY_PORTS,
# nothing else on your Mac.
# Lifecycle: `just chrome-cdp` to start (prompts to wire BROWSER_CDP_URL
# into ~/.hermes/.env on the hermes VM); `just chrome-cdp-stop` (or `just
# stop`/`just down`) to tear down + ALWAYS clear stale BROWSER_CDP_URL (the
# URL embeds the proxy's container IP, which changes on recreate). Requires
# Google Chrome at /Applications/. Profile data: .stack/chrome-cdp/data.
# Port levers (defaults shown; override per-stack):
#   CHROME_CDP_PORT=19298         # Chrome's loopback CDP port (Mac side)
#   CHROME_CDP_BRIDGE_PORT=19299  # proxy's listen port (Hermes connects here)
# Additional host bridges — add CSV "<listen>:<target>" mappings. The chrome
# mapping above is auto-added by `just chrome-cdp`; only set this for OTHER
# host services you want bridged (e.g. a Mac-side postgres on 5432):
#   LOCALHOST_PROXY_PORTS=5433:5432
# Hermes URL form (printed by `just chrome-cdp`): http://<proxy-ip>:<bport>.
# IP literal, NOT hostname — Chrome 111+ rejects hostname Host headers
# (DNS-rebinding defense). Wire automatically via the recipe's prompt, or:
#   orb -m hermes bash -lc 'hermes config set browser.cdp_url http://<ip>:<bport>'
# browser-use: OPTIONAL LLM-driven browser-automation agent (MCP, stdio).
# Opt-in — add `browser-use` (service.env SERVICE_REQUIRES=litellm pulls
# litellm+pg+redis). Heavy (built from pinned _source via upstream Dockerfile
# — bundles Chromium + uv). FULLY LOCAL: no cloud key; telemetry/cloud-sync/
# version-check off; all inference via LiteLLM on the minted
# BROWSER_USE_VIRTUAL_KEY, model = BROWSER_USE_MODEL lever. Ready worker —
# spawn the stdio MCP server on demand:
#   docker exec -i <project>-browser-use-1 python -m browser_use.mcp
COMPOSE_PROFILES=litellm,honcho,agentmemory
# Orb machine(s) for this stack (comma list; '-'/empty = none). For multi-stack
# give each stack its OWN machine name (e.g. hermes, proj2-hermes) so the VMs
# don't collide; each VM is wired to its stack's <svc>.<project>.orb.local.
# ISOLATION (enforced): every VM is --isolated --isolate-network (no Mac file
# sharing, no Mac IPs reachable, no sibling-VM reachable). `just start`
# fail-fasts if a VM's flags drift; bring back into compliance with
# `just restart` (the flags only take effect on next VM start).
STACK_MACHINES=hermes

# Remove exited provisioner containers at the end of `just start`
# (false keeps them so their provisioning logs are inspectable).
STACK_AUTO_REMOVE_PROVISIONERS=false

# Firecrawl resource limits (profile [firecrawl]; lighter than upstream's
# 8G/4CPU + 4G/2CPU defaults — bump per crawl workload).
FIRECRAWL_API_MEM=4g
FIRECRAWL_API_CPU=2
FIRECRAWL_PLAYWRIGHT_MEM=2g
FIRECRAWL_PLAYWRIGHT_CPU=2

# Hermes memory backend (applied to the VM by machines/hermes/build.sh):
#   default     - leave Hermes' own default untouched (no override)
#   honcho      - official plugin -> honcho-api.<project>.orb.local:8000
#   hindsight   - official plugin, local_external -> hindsight.<project>...:8888
#   holographic - official plugin, fully local in the VM (no stack service)
#   agentmemory - THIRD-PARTY: @agentmemory/mcp shim ->
#                 agentmemory.<project>.orb.local:3111 (needs npx on the VM;
#                 deeper 6-hook provider is a manual copy of integrations/hermes)
# Only one is active at a time. The chosen provider's backing service should
# be in COMPOSE_PROFILES (honcho/hindsight/agentmemory); build.sh warns if not.
HERMES_MEMORY=honcho

# === Model levers ===========================================================
# .stack/.env is bash-sourced by `just`, so the ${...} refs below expand.
# Keep PRESETS above the per-service lines that reference them.
#
# Presets — repoint the whole stack at once:
STACK_LLM_MODEL=cliproxy/gpt-5.5            # primary chat (interactive / high-tier)
STACK_LLM_MODEL_FAST=cliproxy/gpt-5.4-mini  # high-volume background tier
STACK_LLM_EMBEDDING_MODEL=voyage-4-lite     # embeddings (via litellm->voyage; NOT cliproxy)
#
# Per-service levers — EVERY model knob is here; nothing hidden in services/*.
# Override any one explicitly (e.g. HONCHO_DERIVER_MODEL=glm-4.7-flash) without
# touching git-tracked configs. Service configs reference ONLY these namespaced
# vars, never STACK_LLM_MODEL* directly.
HERMES_MODEL=${STACK_LLM_MODEL}
AGENTMEMORY_MODEL=${STACK_LLM_MODEL}
AGENTMEMORY_EMBEDDING_MODEL=${STACK_LLM_EMBEDDING_MODEL}
HINDSIGHT_MODEL=${STACK_LLM_MODEL}
HINDSIGHT_EMBEDDING_MODEL=${STACK_LLM_EMBEDDING_MODEL}
# Reranker backend: local | litellm | rrf
#   local   - in-process Torch cross-encoder (best quality; ~600 MB RAM)
#   litellm - rerank via LiteLLM -> HINDSIGHT_RERANK_MODEL (no Torch; ~600 MB
#             saved; observable in SpendLogs; per-rerank Voyage API cost)
#   rrf     - pure rank-fusion (no model/API/RAM; weakest quality)
HINDSIGHT_RERANKER=local
HINDSIGHT_RERANK_MODEL=rerank-voyage
FIRECRAWL_MODEL=${STACK_LLM_MODEL}
BROWSER_USE_MODEL=${STACK_LLM_MODEL}
HONCHO_DERIVER_MODEL=${STACK_LLM_MODEL_FAST}
HONCHO_SUMMARY_MODEL=${STACK_LLM_MODEL_FAST}
HONCHO_DREAM_MODEL=${STACK_LLM_MODEL_FAST}
HONCHO_DIALECTIC_MODEL=${STACK_LLM_MODEL}
HONCHO_EMBEDDING_MODEL=${STACK_LLM_EMBEDDING_MODEL}

# === LiteLLM virtual keys ===================================================
# One key minted per consumer (per-service SpendLogs attribution + rotation),
# minted UNRESTRICTED (all proxy models). Per-key model scoping is unnecessary:
# each service's model is set explicitly above (the levers), so a key can't
# call a model the service wasn't configured for. Just the consumer list:
LITELLM_VIRTKEYS=hermes,honcho,agentmemory,hindsight,firecrawl,browser_use

# === Service versions ========================================================
# All OPTIONAL; defaults are the tracked annotated pins in
# services/<svc>/images.env (digest class) and services/<svc>/build.sh
# (source class).
#
# Tag class — accepts an upstream tag (pulled as-is; minor drift accepted):
#   PG_VERSION=pg18
#   REDIS_VERSION=8.6.3
#   RABBITMQ_VERSION=4.3.0-management
#   CLIPROXY_VERSION=v7.1.11
#
# Digest class — accepts a tag (resolved to digest at build) OR a sha256: digest:
#   LITELLM_VERSION=<tag-or-digest>
#   HINDSIGHT_VERSION=<tag-or-digest>
#   FIRECRAWL_API_VERSION=<tag-or-digest>
#   FIRECRAWL_PLAYWRIGHT_VERSION=<tag-or-digest>
#   FIRECRAWL_POSTGRES_VERSION=<tag-or-digest>
#
# Source class — accepts a tag OR commit SHA (fetched, checked out, rebuilt):
#   HONCHO_VERSION=<tag-or-sha>
#   HONCHO_UI_VERSION=<tag-or-sha>
#   CAMOFOX_BROWSER_VERSION=<tag-or-sha>
#   BROWSER_USE_VERSION=<tag-or-sha>
