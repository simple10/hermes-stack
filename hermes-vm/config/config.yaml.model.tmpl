# The `model:` block patched into ~/.hermes/config.yaml by build-hermes.sh.
# Hermes's own agent brain routes through LiteLLM (provider: custom).
# api_key is a LiteLLM virtual key — NEVER commit the real value; the script
# substitutes ${HERMES_VIRTUAL_KEY} from aitools-services/keys.generated.env.
# Hermes streams, so the LiteLLM chatgpt/* non-streaming bug does not bite
# (see README gotcha #5).
model:
  default: chatgpt/gpt-5.5
  provider: custom
  base_url: http://aitools-litellm.aitools-services.orb.local:4000/v1
  api_key: ${HERMES_VIRTUAL_KEY}
