# The `model:` block patched into ~/.hermes/config.yaml by
# machines/hermes/{build,start}.sh. Hermes's own agent brain routes through
# LiteLLM (provider: custom). api_key is a LiteLLM virtual key — NEVER commit
# the real value; the scripts substitute ${HERMES_VIRTUAL_KEY} from
# .stack/litellm.generated.env. Hermes streams, so the LiteLLM chatgpt/*
# non-streaming bug does not bite (see README gotcha #5).
# base_url uses the project-scoped OrbStack DNS <service>.<project>.orb.local;
# the scripts substitute __STACK_PROJECT__ with COMPOSE_PROJECT_NAME from
# .stack/.env (default `aitools` -> litellm.aitools.orb.local).
model:
  default: chatgpt/gpt-5.5
  provider: custom
  base_url: http://litellm.__STACK_PROJECT__.orb.local:4000/v1
  api_key: ${HERMES_VIRTUAL_KEY}
