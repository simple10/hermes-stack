# The `model:` block patched into ~/.hermes/config.yaml by
# machines/hermes/{build,start}.sh. Hermes's own agent brain routes through
# LiteLLM (provider: custom). api_key is a LiteLLM virtual key — NEVER commit
# the real value; the scripts substitute ${HERMES_VIRTUAL_KEY} from
# .stack/litellm.generated.env. base_url uses the project-scoped OrbStack DNS
# <service>.<project>.orb.local; the scripts substitute __STACK_PROJECT__ with
# COMPOSE_PROJECT_NAME from .stack/.env (default aitools -> litellm.aitools).
#
# default = cliproxy/gpt-5.5: LiteLLM routes this as a plain openai-compatible
# upstream to CLIProxyAPI (ChatGPT/Codex subscription). This is the
# streaming-correct + fully-observable replacement for the old chatgpt/*
# LiteLLM responses-bridge (gotcha #5 non-streaming bug). To roll back, set
# default: chatgpt/gpt-5.5 (the bridge entries are kept in litellm config).
model:
  default: cliproxy/gpt-5.5
  provider: custom
  base_url: http://litellm.__STACK_PROJECT__.orb.local:4000/v1
  api_key: ${HERMES_VIRTUAL_KEY}
