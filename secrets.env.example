# hermes-stack secrets — copy to `secrets.env` (gitignored) and fill in.
# build-stack.sh / build-hermes.sh source `secrets.env`.
#
# These are the ONLY values you must supply. Everything else (Postgres
# super/honcho/litellm passwords, LiteLLM virtual keys) is GENERATED by the
# build scripts into gitignored files (aitools-backends/.env,
# aitools-services/.env, aitools-services/keys.generated.env).

# --- LLM / embedding providers (used by LiteLLM) ---
# OpenRouter key — Honcho's GLM/Grok chat tiers route through here.
# https://openrouter.ai/keys  (format: sk-or-v1-...)
OPENROUTER_API_KEY=

# Voyage AI key — Honcho embeddings (voyage-4-lite @ 1024) route through here.
# https://dashboard.voyageai.com  (format: pa-...)
VOYAGE_API_KEY=

# --- LiteLLM master key ---
# Admin key for the LiteLLM proxy (mints virtual keys, UI auth).
# Leave BLANK to have build-stack.sh generate `sk-$(openssl rand -hex 24)`.
LITELLM_MASTER_KEY=

# --- Telegram (Hermes gateway) ---
# Bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to talk to the bot.
TELEGRAM_ALLOWED_USERS=
# Home channel / chat id the bot posts to (optional; leave blank if unused).
TELEGRAM_HOME_CHANNEL=

# --- NOTES ---
# DB passwords + LiteLLM virtual keys are NOT set here — the scripts derive
# and rotate them. After a Postgres major-version rebuild the LiteLLM DB is
# wiped and virtual keys vanish; re-running build-stack.sh regenerates them
# and re-points Honcho's key (see README gotcha #4).
