# agentmemory NON-SECRET config — COMMITTED, loaded via Compose `env_file:`.
# NO secrets here (no API keys, no AGENTMEMORY_SECRET). Secrets are injected
# separately via the compose `environment:` block, resolved from .stack/.env.
#
# Values mirror upstream agentmemory .env.example DEFAULTS; every line that
# DEVIATES from the upstream default is marked `# DEVIATION:` with why.

# --- LLM via LiteLLM (OpenAI-compatible /v1/chat/completions) ---
# DEVIATION: upstream default has no provider (noop mode). We route the LLM
# through our LiteLLM proxy for key rotation + spend observability, same as
# Honcho. agentmemory appends /v1/chat/completions to OPENAI_BASE_URL.
# Internal service DNS (agentmemory is on the project network with litellm).
OPENAI_BASE_URL=http://litellm:4000
# NOTE: OPENAI_MODEL is NOT set here. It's the AGENTMEMORY_MODEL lever in
# .stack/.env, injected via compose `environment:` (so users change the model
# from the single .stack/.env surface, never this git-tracked file).
# Cap completion tokens for compression/summarise (upstream default 4096).
MAX_TOKENS=4096

# --- Embeddings via LiteLLM ---
# DEVIATION: upstream auto-detects (local 384-dim Xenova by default). We force
# the OpenAI-compatible path so embeddings flow through LiteLLM -> Voyage.
# OPENAI_EMBEDDING_MODEL is the AGENTMEMORY_EMBEDDING_MODEL lever in
# .stack/.env (injected via compose environment). DIMENSIONS is pinned to
# match voyage-4-lite @ 1024 (change here if you repoint the embed model).
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_DIMENSIONS=1024

# --- "Fully capable" feature flags (all DEVIATIONS: upstream defaults these
# OFF to avoid surprise LLM cost; you explicitly want agentmemory fully
# capable, and our LLM cost is not a concern on the glm tier). ---
AGENTMEMORY_AUTO_COMPRESS=true        # LLM compression on every observation batch
CONSOLIDATION_ENABLED=true            # 4-tier consolidation (memories->semantic->procedural)
GRAPH_EXTRACTION_ENABLED=true         # concept-graph edges; powers graph-traversal recall
AGENTMEMORY_REFLECT=true              # periodic auto-synthesised lessons
AGENTMEMORY_TOOLS=all                 # expose all 51 tools (upstream default: core/7)

# NOTE: AGENTMEMORY_INJECT_CONTEXT is intentionally left at its upstream
# default (off). It rewrites a HOST agent's prompts via hooks and only
# matters once agentmemory is wired into Hermes — that's a later step.
