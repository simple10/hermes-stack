# agentmemory: OPENAI_BASE_URL=http://litellm:4000 (in ./.env) + uses
# AGENTMEMORY_VIRTUAL_KEY (minted by litellm/preflight). No compose
# depends_on, so the resolution test cannot catch a miss — declare it.
SERVICE_RUNNER=docker
SERVICE_DESC="Alternative memory backend (file-based; MCP shim for Hermes)"
SERVICE_LITELLM_KEY=true
SERVICE_REQUIRES=litellm
SERVICE_STACK_ENV='
# Bearer/HMAC secret — gen-once via `just setup`. Authoritative over the
# value the agentmemory volume might have baked in (`AGENTMEMORY_SECRET`
# is re-applied by `services/agentmemory/build.ts` on every build).
AGENTMEMORY_SECRET=
# Admin web UI viewer (:3113). 1 = expose at agentmemory.<project>.orb.local:3113
# Set 0 to DISABLE — UNAUTHENTICATED admin surface; 0 keeps it 127.0.0.1-only.
AGENTMEMORY_EXPOSE_VIEWER=1
AGENTMEMORY_MODEL=${STACK_LLM_MODEL}
AGENTMEMORY_EMBEDDING_MODEL=${STACK_LLM_EMBEDDING_MODEL}
'
