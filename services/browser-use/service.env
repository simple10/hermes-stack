# browser-use: depends_on litellm (cross-profile) + OPENAI_BASE_URL=
# http://litellm:4000 ; uses BROWSER_USE_VIRTUAL_KEY (minted by
# litellm/preflight). litellm pulls pg,redis transitively.
SERVICE_RUNNER=docker
SERVICE_DESC="LLM-driven browser-automation agent (MCP stdio; fully local)"
SERVICE_LITELLM_KEY=true
SERVICE_REQUIRES=litellm
SERVICE_STACK_ENV='
BROWSER_USE_MODEL=${STACK_LLM_MODEL}
'

# Source-class. Bump via BROWSER_USE_VERSION in .stack/.env.
BROWSER_USE_SOURCE_REPO=https://github.com/browser-use/browser-use
BROWSER_USE_SOURCE_DEFAULT=157779338afdcc03023010ec3c24ad63d820453c   # main@2026-05-19 (resolve via git describe when _source is checked out)
