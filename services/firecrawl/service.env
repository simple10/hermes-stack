# firecrawl-api depends_on redis, rabbitmq, and litellm (cross-profile).
# Uses its own firecrawl-postgres, NOT shared pg.
SERVICE_REQUIRES=redis,rabbitmq,litellm

# Three digest-class images owned by this service. Bump per-image via
# FIRECRAWL_API_VERSION / FIRECRAWL_PLAYWRIGHT_VERSION /
# FIRECRAWL_POSTGRES_VERSION in .stack/.env.
#
# Provenance (preserved from the deleted .image-digest):
#   Resolved 2026-05-18 from :latest (upstream ships no semver; digest is
#   the only stable pin). Bump deliberately: re-resolve + update in one commit.
FIRECRAWL_API_IMAGE_REPO=ghcr.io/firecrawl/firecrawl
FIRECRAWL_API_IMAGE_DEFAULT=sha256:fb156ea529d2c40acf805872251d921ba15bf17b22b2d5a72bd0aaac30076280            # main@2026-05-18
FIRECRAWL_PLAYWRIGHT_IMAGE_REPO=ghcr.io/firecrawl/playwright-service
FIRECRAWL_PLAYWRIGHT_IMAGE_DEFAULT=sha256:9e0737bc09df28275aab29726b1c0824a7725113945434e843385d487b7f7ec6  # main@2026-05-18
FIRECRAWL_POSTGRES_IMAGE_REPO=ghcr.io/firecrawl/nuq-postgres
FIRECRAWL_POSTGRES_IMAGE_DEFAULT=sha256:f9388bd25ae2e1f1d034518236f993ce236173c1d8800ce24092ea6643a95a33    # main@2026-05-18
