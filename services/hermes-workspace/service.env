# hermes-workspace — Hermes Workspace web UI (ghcr.io/outsourc-e/hermes-workspace).
# Connects to the existing Hermes Agent gateway on the project's hermes VM
# (services/hermes — STACK_MACHINES). SERVICE_REQUIRES=hermes pulls hermes
# in automatically on `just enable`.
#
# Reachability prerequisite: the hermes gateway defaults to loopback inside
# the VM. This service refuses to build (build.ts) until the user opens the
# gate by setting HERMES_GATEWAY_ALLOW_ACCESS=true in .stack/.env. See
# services/hermes/service.env for the security trade-off.
SERVICE_RUNNER=docker
SERVICE_DESC="Hermes Workspace web UI (connects to existing Hermes VM)"
SERVICE_REQUIRES=hermes
SERVICE_STACK_ENV='
HERMES_WORKSPACE_PASSWORD=
# OrbStack auto-HTTPS fronts the workspace at
# https://hermes-workspace.<project>.orb.local — set Secure on session
# cookies + trust the proxy headers orb injects.
HERMES_WORKSPACE_COOKIE_SECURE=true
HERMES_WORKSPACE_TRUST_PROXY=true
'

# Single digest-class image owned by this service. Bump via HERMES_WORKSPACE_VERSION
# in .stack/.env.
#
# Provenance:
#   Resolved 2026-05-21 from :latest (upstream ships no semver; digest is
#   the only stable pin). Bump deliberately: re-resolve + update in one commit.
HERMES_WORKSPACE_IMAGE_REPO=ghcr.io/outsourc-e/hermes-workspace
HERMES_WORKSPACE_IMAGE_DEFAULT=sha256:2d2ba9aa5b1230766267322817e8e51113541780a5797802a582a47cc34a3df3   # latest @ 2026-05-21
