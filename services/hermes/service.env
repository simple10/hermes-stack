# hermes — Hermes-agent runtime, runs as an OrbStack VM (NOT a docker
# container). SERVICE_RUNNER=vm tells just/stacklib to skip compose-profile
# wiring and instead treat this service as a STACK_MACHINES entry.
# services/hermes/{build,start}.sh are invoked by `just build`/`just start`.
SERVICE_RUNNER=vm
SERVICE_DESC="Hermes agent runtime (OrbStack Ubuntu VM)"
SERVICE_LITELLM_KEY=true
# Hermes CONSUMES the stack (honcho/searxng/firecrawl/camofox via orb DNS)
# but those wire-ups are conditional in build.sh — only litellm is strictly
# required (HERMES_VIRTUAL_KEY is minted there). Other services are opt-in
# via their own `just enable <svc>`.
SERVICE_REQUIRES=litellm
SERVICE_STACK_ENV='
# VM user — the unix account inside the VM that owns ~/.hermes/, the
# systemd units, and everything else. Default "hermes" decouples the VM
# from the Mac user. orb create --user "$HERMES_REMOTE_USER" provisions it.
# Existing VMs created with --user mirroring the Mac user (orb default)
# need HERMES_REMOTE_USER set to that username (e.g. HERMES_REMOTE_USER=joe)
# until they get recreated. systemd/* + bin/* are templated with this value
# at install time.
HERMES_REMOTE_USER=hermes
HERMES_MODEL=${STACK_LLM_MODEL}
# Memory backend (applied to the VM by services/hermes/build.sh):
#   default     - leave Hermes own default untouched (no override)
#   honcho      - official plugin -> honcho-api.<project>.orb.local:8000
#   hindsight   - official plugin, local_external -> hindsight...:8888
#   holographic - official plugin, fully local in the VM (no stack service)
#   agentmemory - THIRD-PARTY: @agentmemory/mcp shim
# Only one is active at a time. The chosen providers backing service should
# be enabled separately (build.sh warns if not).
HERMES_MEMORY=honcho
# Telegram bot (Hermes gateway). All three blank-ok; setup prompts on
# enable. Lives in the hermes block so setup only asks if hermes is
# actually enabled. The HERMES_ prefix is the stack-side namespace;
# services/hermes/build.sh maps these into ~/.hermes/.env under the
# upstream'"'"'s un-prefixed names (TELEGRAM_*), which is what hermes-agent
# reads inside the VM.
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_ALLOWED_USERS=
HERMES_TELEGRAM_HOME_CHANNEL=
# HERMES_GATEWAY_ALLOW_ACCESS — Bind the Hermes Agent gateway (:8642) to
# 0.0.0.0 so containers on this project'"'"'s docker network can reach it
# at HERMES_GATEWAY_URL (auto-written to .stack/hermes/.generated.env by
# services/hermes/build.sh when the gate is open). Default false: the
# gateway binds VM-loopback only, unreachable from outside the VM.
#
# Flip true ONLY when a service that calls the gateway API needs it
# (e.g. hermes-workspace). Dependent services'"'"' build.sh refuses with
# a clear opt-in instruction when the gate is closed.
#
# SECURITY: When true, any container on this project'"'"'s orb network can
# reach the gateway. HERMES_GATEWAY_API_KEY is REQUIRED in that mode
# (build refuses otherwise) and is required on every inbound request.
# Do not pair with any service that publishes :8642 onto the LAN.
HERMES_GATEWAY_ALLOW_ACCESS=false
# API token enforced by the gateway when ALLOW_ACCESS=true. Minted by
# `just setup` when the gate is open and the key is empty.
HERMES_GATEWAY_API_KEY=
# Bind-mount Hermes home (~/.hermes) from this Mac path into the VM, so
# `just build'"'"'s config edits happen locally + `_bak/` tar of .stack/
# captures the full Hermes state. heavy native bits (venv at
# /opt/hermes-agent; Linux node binary in ~/.hermes/node) bypass the share
# or are relocated via HERMES_INSTALL_DIR. Default on; flip false to
# disable mount management AND skip build-time edits to ~/.hermes/ (each
# skipped step prints the manual orb command).
HERMES_MOUNT_ENABLED=true
# Mac-side source for the mount. Relative paths resolved against the
# repo root. Must exist + contain a populated config.yaml before each
# build (first-build path: the hermes installer populates this dir).
HERMES_MOUNT_DIR=.stack/hermes/.hermes
'
