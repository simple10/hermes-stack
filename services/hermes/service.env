# hermes — Hermes-agent runtime, runs as an OrbStack VM (NOT a docker
# container). SERVICE_RUNNER=vm tells just/stacklib to skip compose-profile
# wiring and instead treat this service as a STACK_MACHINES entry. build.sh
# / start.sh here are invoked by `just build` / `just start` exactly as the
# old machines/hermes/* were — the only thing that changed is the on-disk
# location (machines/ -> services/, unifying the discovery surface).
SERVICE_RUNNER=vm
# SERVICE_REQUIRES is empty here even though Hermes CONSUMES the stack (it
# talks to litellm/honcho/searxng/firecrawl/camofox via orb DNS). The user
# enables those services separately; build.sh wires only what's actually
# present in COMPOSE_PROFILES at build time (idempotent conditional blocks).
