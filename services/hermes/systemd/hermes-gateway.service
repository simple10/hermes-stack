[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=joe
Group=joe
ExecStart=/home/joe/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace
WorkingDirectory=/home/joe/.hermes/hermes-agent
Environment="HOME=/home/joe"
Environment="USER=joe"
Environment="LOGNAME=joe"
Environment="PATH=/home/joe/.hermes/hermes-agent/venv/bin:/home/joe/.hermes/hermes-agent/node_modules/.bin:/home/joe/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/joe/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/joe/.hermes"
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
