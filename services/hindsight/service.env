# hindsight: depends_on pg AND litellm (cross-profile; litellm pulls redis).
SERVICE_RUNNER=docker
SERVICE_DESC="Alternative memory backend (pgvector + reranker; local/litellm/rrf)"
SERVICE_LITELLM_KEY=true
SERVICE_REQUIRES=pg,litellm
SERVICE_STACK_ENV='
HINDSIGHT_MODEL=${STACK_LLM_MODEL}
HINDSIGHT_EMBEDDING_MODEL=${STACK_LLM_EMBEDDING_MODEL}
# Reranker backend: local | litellm | rrf
#   local   - in-process Torch cross-encoder (best quality; ~600 MB RAM)
#   litellm - rerank via LiteLLM -> HINDSIGHT_RERANK_MODEL (no Torch;
#             ~600 MB saved; observable in SpendLogs)
#   rrf     - pure rank-fusion (weakest quality; no model/API/RAM)
HINDSIGHT_RERANKER=litellm
HINDSIGHT_RERANK_MODEL=rerank-voyage
'

# Digest-class image. Bump via HINDSIGHT_VERSION in .stack/.env.
HINDSIGHT_IMAGE_REPO=ghcr.io/vectorize-io/hindsight
HINDSIGHT_IMAGE_DEFAULT=sha256:f0f9e9a73d6aedde9eaf4010ab604c3e015494e494318b26f1011144856b8112  # main@2026-05-18
