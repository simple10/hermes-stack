# honcho-ui depends_on honcho-api (cross-profile -> honcho). Static SPA;
# no model/runtime levers — all behavior comes from honcho-api.
SERVICE_RUNNER=docker
SERVICE_DESC="OpenConcho web UI for Honcho (static SPA + same-origin proxy)"
SERVICE_REQUIRES=honcho

# Source-class. Bump via HONCHO_UI_VERSION in .stack/.env.
HONCHO_UI_SOURCE_REPO=https://github.com/offendingcommit/openconcho
HONCHO_UI_SOURCE_DEFAULT=e490d911fcb27ee193558fd9a28856cde2057665   # v0.8.0-5-ge490d91 (main, 2026-05-15)
