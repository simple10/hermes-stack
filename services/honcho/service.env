# honcho-api: depends_on pg, redis, AND litellm (cross-profile).
SERVICE_RUNNER=docker
SERVICE_LITELLM_KEY=true
SERVICE_REQUIRES=pg,redis,litellm
SERVICE_STACK_ENV='
# Honcho LLM model levers (per-stage; FAST tier for deriver/summary/dream,
# main tier for dialectic). Edit a value to override that stage; bump the
# whole stack at once via STACK_LLM_MODEL[_FAST] in the litellm block.
HONCHO_DERIVER_MODEL=${STACK_LLM_MODEL_FAST}
HONCHO_SUMMARY_MODEL=${STACK_LLM_MODEL_FAST}
HONCHO_DREAM_MODEL=${STACK_LLM_MODEL_FAST}
HONCHO_DIALECTIC_MODEL=${STACK_LLM_MODEL}
HONCHO_EMBEDDING_MODEL=${STACK_LLM_EMBEDDING_MODEL}
'

# Source-class (built from pinned _source). Bump via HONCHO_VERSION in
# .stack/.env (tag or commit SHA). Tracked default MUST stay annotated.
HONCHO_SOURCE_REPO=https://github.com/plastic-labs/honcho
HONCHO_SOURCE_DEFAULT=8fcbb54a49292341dba79d606ee332c50778429b   # v3.0.6-51-g8fcbb54 (main, 2026-05-14)
