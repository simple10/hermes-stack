# litellm — digest-class (ghcr). Bump via LITELLM_VERSION in .stack/.env
# (tag like main-v1.79.0-stable, or sha256: digest). Default is immutable +
# annotated with its provenance.
LITELLM=ghcr.io/berriai/litellm-database@sha256:7bb80500033392233c79f74d4f99d43512da47626cdc9bf46e53df16803d88cd  # main@2026-05-18
