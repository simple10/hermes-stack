# litellm-provision -> pg; litellm uses REDIS_URL (no compose depends_on).
SERVICE_RUNNER=docker
SERVICE_REQUIRES=pg,redis
# LiteLLM is the ISSUER of virtual keys (LITELLM_VIRTKEYS); it doesn't
# consume one itself. So SERVICE_LITELLM_KEY stays false here.
SERVICE_STACK_ENV='
# === Stack-wide LLM model levers (consumed by every LiteLLM-using service) ==
# Overridable per-service via the consuming services *_MODEL levers below
# each service block. Repoint the whole stack at once by editing here.
STACK_LLM_MODEL=cliproxy/gpt-5.5            # primary chat (interactive / high-tier)
STACK_LLM_MODEL_FAST=cliproxy/gpt-5.4-mini  # high-volume background tier
STACK_LLM_EMBEDDING_MODEL=voyage-4-lite     # embeddings (via litellm->voyage)
'

# Digest-class image (resolved by stack_resolve_images at `just build`).
# Bump tag/digest via LITELLM_VERSION in .stack/.env.
LITELLM_IMAGE_REPO=ghcr.io/berriai/litellm-database
LITELLM_IMAGE_DEFAULT=sha256:7bb80500033392233c79f74d4f99d43512da47626cdc9bf46e53df16803d88cd  # main@2026-05-18
