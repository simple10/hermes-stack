# litellm-provision -> pg; litellm uses REDIS_URL (no compose depends_on).
SERVICE_REQUIRES=pg,redis

# Digest-class image (resolved by stack_resolve_images at `just build`).
# Bump tag/digest via LITELLM_VERSION in .stack/.env.
LITELLM_IMAGE_REPO=ghcr.io/berriai/litellm-database
LITELLM_IMAGE_DEFAULT=sha256:7bb80500033392233c79f74d4f99d43512da47626cdc9bf46e53df16803d88cd  # main@2026-05-18
