# litellm-provision -> pg; litellm uses REDIS_URL (no compose depends_on).
SERVICE_RUNNER=docker
SERVICE_DESC="LLM proxy gateway + virtual-key issuer (every consumer routes through here)"
SERVICE_REQUIRES=pg,redis
# LiteLLM is the ISSUER of virtual keys (LITELLM_VIRTKEYS); it doesn't
# consume one itself. So SERVICE_LITELLM_KEY stays false here.
SERVICE_STACK_ENV='
# Admin master key + active virtual-key consumer list. Both gen-once via
# `just setup`; rotating LITELLM_MASTER_KEY invalidates the SpendLogs DB
# auth + breaks the gateway, dont touch lightly.
LITELLM_MASTER_KEY=
# Active consumer list — auto-managed by lib_enable/disable_service when
# any service with SERVICE_LITELLM_KEY=true is enabled/disabled. Per-key
# virtual keys minted by litellm/preflight.sh into
# .stack/litellm/.generated.env (<SVC>_VIRTUAL_KEY=sk-...).
LITELLM_VIRTKEYS=
'

# Digest-class image (resolved by stack_resolve_images at `just build`).
# Bump tag/digest via LITELLM_VERSION in .stack/.env.
LITELLM_IMAGE_REPO=ghcr.io/berriai/litellm-database
LITELLM_IMAGE_DEFAULT=sha256:069da8855c7bf0a39861fcd9884f134670128b79aa930a4af0c9219a0433b83f  # v1.85.0 (2026-05-20)
