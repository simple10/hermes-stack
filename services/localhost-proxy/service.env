# localhost-proxy is standalone — no SERVICE_REQUIRES. It's not built from a
# pinned _source either; the Dockerfile.ci is the source of truth (5 lines:
# alpine + apk add socat bash). No image-version lever needed — bump
# alpine pin in Dockerfile.ci directly when the next major drops.
SERVICE_RUNNER=docker
SERVICE_DESC="Mac-host socat bridge for isolated VMs (used by just chrome-cdp)"
SERVICE_STACK_ENV='
# Comma-separated <listen>:<target> mappings (e.g. 19299:19298,5433:5432).
# Empty = container sleeps (no listeners; safe default). Add ports here to
# bridge them from the Mac host into the isolated VM via the orb network.
# `just chrome-cdp-enable` csv_adds its bridge mapping; `chrome-cdp-disable`
# csv_removes it. User-added entries (other mappings) survive both.
LOCALHOST_PROXY_PORTS=
# chrome-cdp recipe port levers. Non-default ports avoid colliding with any
# other CDP on this Mac; multi-stack: each stack picks its own ports for
# independent CDPs (or share by using the same ports across stacks).
CHROME_CDP_PORT=19298
CHROME_CDP_BRIDGE_PORT=19299
'
