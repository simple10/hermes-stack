# Honored by both npm and pnpm.
#
# auto-install-peers (pnpm): silently install peer deps that aren't declared.
#   Needed because @cloudflare/vitest-pool-workers pins vitest@2.0.x as a
#   peer but we ship 2.1.0; without this flag pnpm warns on every install.
auto-install-peers=true

# strict-peer-dependencies (pnpm): downgrade peer mismatches from error → warn.
#   Same reason as above; lets the install complete on first run.
strict-peer-dependencies=false
