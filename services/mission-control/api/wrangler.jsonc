{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mission-control-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  // nodejs_compat enables node:* imports (used by better-auth core for
  // async_hooks). Required at runtime; without it: "No such module
  // 'node:async_hooks'" on first request.
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
  },

  // Single DB in dev (single-DB mode); SaaS prod overrides via env-specific blocks.
  // TODO: Run `wrangler login && wrangler d1 create mission-control-dev` and
  // replace the placeholder database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mission-control-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/combined",
    },
  ],

  "vars": {
    "DB_MODE": "single",
    // better-auth baseURL — used to build links in verification / reset
    // emails. In dev = this Worker's wrangler dev origin.
    "BETTER_AUTH_URL": "http://localhost:8787",
    // The UI Worker (mission-control-ui) runs on a separate origin. In dev
    // its Vite server (`:5173`) proxies /api/* here so requests appear
    // same-origin; in prod the two are cross-origin and need CORS allowing
    // the UI's deployed origin(s) — comma-separated.
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173",
    // EMAIL_FROM intentionally unset in dev → sendEmail() no-ops (logs only).
    // To actually send mail in dev, set EMAIL_FROM and add a send_email binding.
  },

  // ── Production SaaS environment (`wrangler deploy --env production`) ─────
  // Split-DB mode with separate master + pool bindings, plus cron triggers
  // for events / idempotency / verification purges, plus Cloudflare Email
  // Service binding for transactional outbound mail.
  "env": {
    "production": {
      "vars": {
        "DB_MODE": "split",
        "BETTER_AUTH_URL": "https://api.mc.example.com",
        "CORS_ALLOWED_ORIGINS": "https://mc.example.com",
        "EMAIL_FROM": "no-reply@mc.example.com",
      },
      "send_email": [{ "name": "EMAIL", "remote": true }],
      "d1_databases": [
        {
          "binding": "MASTER_DB",
          "database_name": "mc-master-prod",
          "database_id": "REPLACE_WITH_PROD_MASTER_ID",
          "migrations_dir": "migrations/master",
        },
        {
          "binding": "POOL_DEFAULT",
          "database_name": "mc-pool-default-prod",
          "database_id": "REPLACE_WITH_PROD_POOL_DEFAULT_ID",
          "migrations_dir": "migrations/pool",
        },
      ],
      "triggers": {
        "crons": [
          "0 3 * * *", // events purge — see src/jobs/cron.ts
          "0 4 * * *", // idempotency purge
          "*/15 * * * *", // verification purge
        ],
      },
    },
  },
}
