{
  "name": "mission-control",
  "version": "0.0.1",
  "private": true,
  "description": "Multi-tenant master kanban API for multi-agent task coordination",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/routes/ src/auth/middleware.ts",
    "cf:types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "auth:generate": "better-auth generate",
    "db:combine": "node scripts/build-combined-migrations.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-virtual": "^3.13.24",
    "better-auth": "1.6.11",
    "drizzle-orm": "1.0.0-rc.3",
    "hono": "4.12.19",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.2",
    "@cloudflare/vitest-pool-workers": "0.16.6",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.168.6",
    "@types/node": "24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "1.0.0-rc.3",
    "eslint": "^9.18.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
