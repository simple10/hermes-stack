# mission-control — multi-tenant master kanban API for multi-agent coordination.
# Self-host target: Docker image built from services/mission-control/Dockerfile.
# SaaS target: Cloudflare Workers (deploy via `npm run deploy`).
#
# Image config — placeholder until the image is published to a registry.
# Set MC_IMAGE in .stack/.env to override (e.g. ghcr.io/org/mission-control:v1.0.0).
# While developing locally the image is always built fresh by build.sh.
SERVICE_RUNNER=docker
SERVICE_DESC="MissionControl master kanban API (multi-agent coordination)"

MC_IMAGE_REPO=mission-control
MC_IMAGE_DEFAULT=local

SERVICE_STACK_ENV='
# REQUIRED — mint with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# REQUIRED for first-run bootstrap (can be removed after first user exists)
MC_ADMIN_TOKEN=

# Optional — comma-separated browser origins allowed by CORS
CORS_ALLOWED_ORIGINS=

# Tuning (defaults shown)
# EVENTS_RETENTION_DAYS=365
# IDEMPOTENCY_TTL_SECONDS=86400
# KEY_ROTATION_GRACE_SECONDS=300

# Port exposed on the host (container always listens on 8787)
# MC_PORT=8787
'
