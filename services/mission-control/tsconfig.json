{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // node = Node built-ins (Buffer, fs, process) for the self-host entry.
    // Cloudflare Workers types come from `worker-configuration.d.ts`, generated
    // by `pnpm cf:types` (wrangler types). Re-run that whenever wrangler.jsonc
    // bindings change.
    "types": ["node", "./worker-configuration.d.ts"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "drizzle.config.ts", "worker-configuration.d.ts"]
}
