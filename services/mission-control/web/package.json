{
  "name": "mission-control-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Multi-tenant master kanban API for multi-agent task coordination",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "vitest run --config web/vitest.config.ts",
    "bundle:report": "vite build && du -sh dist/ && du -sh dist/assets/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth-ui/core": "^1.6.8",
    "@better-auth-ui/react": "^1.6.8",
    "@better-auth/api-key": "1.6.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-virtual": "^3.13.24",
    "better-auth": "1.6.11",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.168.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "happy-dom": "^20.9.0",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.0",
    "vitest": "4.1.6"
  },
  "packageManager": "pnpm@11.2.1"
}
