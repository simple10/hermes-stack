{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mission-control-ui",
  "compatibility_date": "2026-05-22",

  "observability": {
    "enabled": true,
  },

  // Assets-only Worker — no `main` field. The Cloudflare Vite plugin
  // auto-populates `assets.directory` and `assets.binding` at build time,
  // so we only declare behavior here:
  //   - not_found_handling: "single-page-application" → unmatched paths fall
  //     through to index.html so TanStack Router can take over client-side.
  // API calls go to a separate Worker (mission-control-api) and are proxied
  // through the Vite dev server in dev (see vite.config.mts).
  "assets": {
    "not_found_handling": "single-page-application",
  },
}
