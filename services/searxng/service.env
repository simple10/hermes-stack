# searxng: standalone metasearch engine (no pg/redis/litellm dep). Reached
# by sibling services and the hermes VM at searxng.<project>.orb.local:8080;
# Hermes wires SEARXNG_URL automatically when this profile is active.
SERVICE_RUNNER=docker
SERVICE_STACK_ENV='
# Tag-class image (drift OK). Date-formatted tags from upstream are immutable.
SEARXNG_VERSION=2026.5.17-d7e8b7cd1
SEARXNG_CPU=1
SEARXNG_MEM=512m
'
