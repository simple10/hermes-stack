{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "services/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/_source/**", ".stack-node/**", ".stack/**"]
}
